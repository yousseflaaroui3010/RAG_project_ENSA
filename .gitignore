# --- Secrets and local config (never commit) ---
.env
.env.*
!.env.example
secrets/

# --- Runtime data, documents, and generated stores (Sanad) ---
data/
**/qdrant_storage/
**/parent_store/
*.sqlite
*.sqlite3
*.db

# --- Model / embedding caches ---
.cache/
**/.huggingface/
models/

# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
/dist/
/build/
# uv.lock IS committed on purpose (exact-version authority, ADR-10)
# (anchored to repo root so they never swallow docs/build/)

# --- dev tooling local logs and markers (not source) ---
.devtools/logs/

# --- Agent worktrees (live git worktrees; never a tracked gitlink) ---
.devtools/worktrees/

# --- Per-agent scratch memory (machine-local, unreviewed, goes stale) ---
# Durable facts belong in docs/build/BUILD-STATE.md and DECISIONS.md, which
# are reviewed and versioned. Committing agent memory would duplicate those
# and let an unreviewed copy contradict them.
.devtools/agent-memory/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local backups and archives (never tracked) ---
*.bak
*.zip
*.bak
*.retired
.devtools.json
**/node_modules/
**/.env
**/.env.*
*.key
*.pem
settings.local.json
evals/fixture/node_modules/
# --- the assistant harness installer payload (NOT Sanad source) ---
# Unpacked here by the assistant-harness.zip; install.ps1 copies it to ~/.devtools.
# It must never be committed: it is a personal, cross-project control plane,
# not part of this product. Mirrored in pyproject [tool.ruff] extend-exclude
# and in .cbmignore; if you add an entry, add it in all three.
/agents/
/commands/
/hooks/
/rules/
/rules-scoped/
/skills/
/lessons/
/evals/
/history/
/settings.json
/install.ps1

# --- Local code-graph artifact (regenerated, not shared) ---
.codebase-memory/

# --- Stray duplicates from botched extracts ---
# Windows drops these when an archive is unpacked over existing files.
# 'README copy.md' is the harness's own README, not Sanad's.
* copy
* copy.*
