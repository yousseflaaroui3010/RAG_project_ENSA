# --- Secrets and local config (never commit) ---
.env
.env.*
!.env.example
secrets/

# --- Runtime data, documents, and generated stores (Sanad) ---
data/
**/qdrant_storage/
**/parent_store/
*.sqlite
*.sqlite3
*.db

# --- Model / embedding caches ---
.cache/
**/.huggingface/
models/

# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
/dist/
/build/
# uv.lock IS committed on purpose (exact-version authority, ADR-10)
# (anchored to repo root so they never swallow docs/build/)

# --- Claude Code local logs and markers (not source) ---
.claude/logs/

# --- Agent worktrees (live git worktrees; never a tracked gitlink) ---
.claude/worktrees/

# --- Per-agent scratch memory (machine-local, unreviewed, goes stale) ---
# Durable facts belong in docs/build/BUILD-STATE.md and DECISIONS.md, which
# are reviewed and versioned. Committing agent memory would duplicate those
# and let an unreviewed copy contradict them.
.claude/agent-memory/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local backups and archives (never tracked) ---
*.bak
*.zip
*.bak
*.retired
.claude.json
**/node_modules/
**/.env
**/.env.*
*.key
*.pem
settings.local.json
evals/fixture/node_modules/

# --- Local code-graph artifact (regenerated, not shared) ---
.codebase-memory/

# --- Stray duplicates from botched extracts ---
# Windows drops these when an archive is unpacked over existing files.
# 'README copy.md' is the harness's own README, not Sanad's.
* copy
* copy.*
