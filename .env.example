# Sanad environment configuration.
# Copy to .env (git-ignored) and fill in real values: `cp .env.example .env`
# Every variable here maps 1:1 to a field in config.py (Settings). No
# tunable may exist in module code without also existing here.

# --- Model provider selection (ADR-06) ---
# "cloud" or "strict_local". strict_local needs Ollama running locally
# with an instruction-following model of 7B+ parameters (offline fallback).
MODEL_MODE=cloud
# Cloud chat model name, used when MODEL_MODE=cloud.
CHAT_MODEL_CLOUD=gpt-4o-mini
# Local chat model name (via Ollama), used when MODEL_MODE=strict_local.
CHAT_MODEL_LOCAL=llama3.1:8b-instruct
# API key for the configured cloud provider. Never commit a real value.
CLOUD_API_KEY=your-cloud-provider-api-key-here
# Base URL of the local Ollama server for strict-local mode.
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings (ADR-05) ---
# Dense multilingual embedding model (French corpus; do not swap to an
# English-only model). 768-dim output.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DENSE_DIM=768
# Sparse embedding model for hybrid retrieval.
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
# Mandatory prefixes for E5-family models; omitting them degrades
# retrieval silently. A unit test enforces these are always applied.
EMBEDDING_PASSAGE_PREFIX=passage: 
EMBEDDING_QUERY_PREFIX=query: 

# --- Agent behavior (F-03 to F-07) ---
# Max reword-and-retry attempts before the agent refuses honestly (F-04/F-05).
RETRY_CEILING=2
# Number of child chunks pulled per hybrid search.
RETRIEVAL_DEPTH_K=5

# --- Chunking (architecture section 7.5) ---
# Child chunk size in characters (kept well under the E5 512-token limit).
CHUNK_CHILD_SIZE_CHARS=500
# Overlap between consecutive child chunks, in characters.
CHUNK_CHILD_OVERLAP_CHARS=100
# Parent sections below this size (chars) get merged with a neighbor.
PARENT_MERGE_BELOW_CHARS=2000
# Parent sections above this size (chars) get split further.
PARENT_SPLIT_ABOVE_CHARS=4000

# --- Store paths (LD-06: all derived data stays on operator disk) ---
QDRANT_STORAGE_PATH=data/qdrant/
PARENT_STORE_PATH=data/parents/
SQLITE_DB_PATH=data/sanad.db
REPORTS_PATH=data/reports/

# --- Server (ADR-13, LD-07: single-user, no auth, localhost only) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
