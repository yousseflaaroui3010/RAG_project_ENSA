# Sanad configuration -- copy to .env and fill in. Every variable maps to a
# field in config.py (pydantic-settings). .env is gitignored; never commit secrets.

# --- Model provider (ADR-06: two modes) ---
# "cloud" = Google Gemini (free tier); "strict_local" = free local model via Ollama.
MODEL_MODE=cloud
# Cloud: a Gemini model on the free tier (Google AI Studio).
CHAT_MODEL_CLOUD=gemini-3.6-flash
# Local: an Ollama instruct model >= 7B (e.g. mistral, llama3.1).
CHAT_MODEL_LOCAL=mistral
# Gemini / Google AI Studio API key (cloud mode only); free at aistudio.google.com.
CLOUD_API_KEY=
# Ollama server URL for strict-local mode.
OLLAMA_BASE_URL=http://localhost:11434
# Seconds before one model call gives up (PRD section 11 unreachable path).
MODEL_CALL_TIMEOUT_SECONDS=60.0
# Retries for one failed cloud call before giving up; no effect in strict-local mode.
MODEL_CALL_MAX_RETRIES=2

# --- Embeddings (ADR-05) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DENSE_DIM=768
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
# Mandatory E5 prefixes -- do not change (unit-test enforced).
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# --- Agent behavior (F-03..F-07) ---
RETRY_CEILING=2
RETRIEVAL_DEPTH_K=5
# Bounds on one question, matching openapi AskRequest so the in-process UI
# and the HTTP route reject the same input (ADR-13 has the UI calling the
# service function directly, so the route's validation is not in that path).
QUESTION_MIN_LENGTH=1
QUESTION_MAX_LENGTH=2000
# Rolling F-07 memory bounds. The first caps one consolidation request; the
# second caps the compact summary retained for every later question.
SESSION_MEMORY_INPUT_MAX_CHARS=16000
SESSION_SUMMARY_MAX_CHARS=2000
# How many sub-queries ST-22's rewrite-and-split may produce for one
# question. It is a COST ceiling, not a quality knob: every extra query is
# a real search and, on retry, more model calls.
MAX_SUB_QUERIES=5

# --- Chunking (architecture 7.5) ---
CHUNK_CHILD_SIZE_CHARS=500
CHUNK_CHILD_OVERLAP_CHARS=100
PARENT_MERGE_BELOW_CHARS=2000
PARENT_SPLIT_ABOVE_CHARS=4000
# What counts as a citable unit inside a section, for the F-03 label. A
# legal corpus numbers its articles, so a passage is cited as "Article 231"
# rather than by the heading it happens to sit under. A corpus with no
# numbered unit falls back to the enclosing heading automatically. "Slide N"
# is the same idea for PowerPoint decks (F-11); "المادة N" is the same idea
# again for Arabic legal text (F-14) -- Moroccan statutes in Arabic number
# articles as "المادة 12", and \d already matches Eastern Arabic-Indic
# digits (١٢) too, verified empirically, so no separate digit class is
# needed. Its spaces are ZERO-OR-MORE (\s*), not one-or-more like
# Article/Slide: real Arabic OCR (F-16, tessdata_fast ara) reads
# "المادة12" with no space at all, and chunking.py's `_citation_label`
# re-inserts exactly one space in the LABEL it shows either way, so a
# source card always reads "المادة 12". Adding it changed no existing
# citation (0 of the 187 stored parents contain "المادة" plus a digit,
# checked 2026-09-13).
PARENT_CITATION_MARKER_PATTERN=Article\s+\d+|Slide\s+\d+|المادة\s*\d+

# --- Workspaces (F-01) ---
# Validation bounds on a workspace name and its folder path. Names are
# normalised before they are checked AND before they are stored -- ST-11
# shipped a bug where those two disagreed, validating a stripped name and
# persisting the raw one.
WORKSPACE_NAME_MIN_LENGTH=1
WORKSPACE_NAME_MAX_LENGTH=100
WORKSPACE_FOLDER_PATH_MIN_LENGTH=1
# PRD section 10 soft caps. Crossing either shows a warning but does not
# block Sync.
WORKSPACE_SOFT_CAP_PAGES=1500
WORKSPACE_SOFT_CAP_FILES=50

# --- Ingestion (F-02, architecture 5.1) ---
# The file types Sync processes in V1 (LD-03). Anything else is reported
# Skipped with a reason and never silently ignored. Change detection and
# the conversion ladder BOTH read this one list, so a file can never be
# scanned as one type and converted as another.
SUPPORTED_DOCUMENT_EXTENSIONS=["pdf","docx","txt","md","pptx"]
# Block size for the content hash, in bytes (1 MiB). Files are hashed
# incrementally so a large PDF never lands in memory whole.
HASH_READ_CHUNK_BYTES=1048576
# How long a SQLite connection waits for a lock before giving up. sqlite3's
# own default is 5 seconds, which is short for a sync writing a row per
# file; a test pins that this value is what actually gets passed.
SQLITE_BUSY_TIMEOUT_SECONDS=30.0

# --- Conversion ladder (ST-13, ADR-07) ---
# Minimum non-whitespace characters a converted file must yield before it
# counts as having a readable text layer. Below this it is Skipped, which is
# the binding V1 behaviour for a scanned PDF (PRD F-16).
CONVERSION_MIN_TEXT_CHARS=1
# Codec for the TXT / MD passthrough. utf-8-sig reads plain UTF-8 and also
# strips the byte-order mark Windows editors prepend. Decoding is strict:
# a file in another encoding is reported Failed, never silently mojibaked.
TEXT_FILE_ENCODING=utf-8-sig

# --- Store paths (data locality LD-06; all under data/, gitignored) ---
QDRANT_STORAGE_PATH=data/qdrant/
PARENT_STORE_PATH=data/parents/
SQLITE_DB_PATH=data/sanad.db
REPORTS_PATH=data/reports/

# --- Evaluation (ST-32, F-08, architecture 5.3/9) ---
# G1: at least this fraction of golden-set answers must be fully grounded.
EVAL_GROUNDEDNESS_THRESHOLD=0.90

# --- Server (ADR-13; localhost only, LD-07) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Shared password in front of every route, for a PUBLISHED container only
# (ST-05, Railway hosting). Empty = no gate = ADR-13's local default,
# unchanged. Set it whenever SERVER_HOST is not a loopback address.
ACCESS_PASSWORD=
# Read-only mode for a container too small to load the embedding model:
# Sync and Chat decline with a sentence instead of crashing. False on a
# laptop; set true only on a memory-capped published instance.
EVIDENCE_ONLY=false

# --- Interface language ---
# fr (default), ar or en. Each visitor can switch from the header; the
# choice is remembered in the browser.
DEFAULT_UI_LANGUAGE=fr

# --- Live folder watching (F-13, V2, off by default) ---
# Auto-ingest a new, fully-written file dropped into a workspace folder,
# without pressing Sync. Polling only (architecture excludes watchdog for
# F-13). Never runs when EVIDENCE_ONLY is true.
WATCH_FOLDERS=false
# Seconds between folder polls; also roughly the extra delay before a
# newly dropped file is picked up. Must be > 0.
WATCH_INTERVAL_SECONDS=5.0

# --- Answer feedback (F-15, V2, thumbs up/down plus an optional comment) ---
# Longest comment a thumbs-down note may carry; checked server-side and
# mirrored onto the S1 textarea's maxlength.
FEEDBACK_COMMENT_MAX_CHARS=2000

# --- OCR for scanned PDFs (F-16, V2 Lowest, off by default) ---
# Folder holding tessdata_fast *.traineddata language files (download from
# https://github.com/tesseract-ocr/tessdata_fast). Empty = OCR off = a
# scanned PDF stays Skipped with the existing reason, exactly like V1.
# Uses PyMuPDF's built-in Tesseract -- no separate Tesseract install needed.
OCR_TESSDATA_DIR=
# "+"-joined Tesseract language codes tried together in one OCR pass.
OCR_LANGUAGES=fra+ara+eng
# Render resolution for the OCR pass, 72-600.
OCR_DPI=300
# A scanned PDF longer than this many pages is Skipped with the limit
# stated, rather than OCR'd, so one huge scan cannot stall a Sync.
OCR_MAX_PAGES=200


# Largest single document the browser upload accepts, in bytes (S6). Default 50 MB.
UPLOAD_MAX_BYTES=52428800

# How Sanad is protected (S6): none = local, no login; password = one shared
# password (ACCESS_PASSWORD); keycloak = named people with roles.
AUTH_MODE=none
# Only used when AUTH_MODE=keycloak. The realm's base URL.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=sanad
# The confidential client's secret. Never commit a real one.
KEYCLOAK_CLIENT_SECRET=
# Must match the redirect URI configured on the Keycloak client exactly.
KEYCLOAK_REDIRECT_URL=http://127.0.0.1:8000/auth/callback
# Realm roles are read as <prefix>admin, <prefix>curator, <prefix>reader.
AUTH_ROLE_PREFIX=sanad-
# How long a signed-in browser stays signed in, in hours.
SESSION_TTL_HOURS=12

CHAT_HISTORY_RETENTION_DAYS=30



