# Sanad configuration -- copy to .env and fill in. Every variable maps to a
# field in config.py (pydantic-settings). .env is gitignored; never commit secrets.

# --- Model provider (ADR-06: two modes) ---
# "cloud" = Google Gemini (free tier); "strict_local" = free local model via Ollama.
MODEL_MODE=cloud
# Cloud: a Gemini model on the free tier (Google AI Studio).
CHAT_MODEL_CLOUD=gemini-3.6-flash
# Local: an Ollama instruct model >= 7B (e.g. mistral, llama3.1).
CHAT_MODEL_LOCAL=mistral
# Gemini / Google AI Studio API key (cloud mode only); free at aistudio.google.com.
CLOUD_API_KEY=
# Ollama server URL for strict-local mode.
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings (ADR-05) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DENSE_DIM=768
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
# Mandatory E5 prefixes -- do not change (unit-test enforced).
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# --- Agent behavior (F-03..F-07) ---
RETRY_CEILING=2
RETRIEVAL_DEPTH_K=5
# Bounds on one question, matching openapi AskRequest so the in-process UI
# and the HTTP route reject the same input (ADR-13 has the UI calling the
# service function directly, so the route's validation is not in that path).
QUESTION_MIN_LENGTH=1
QUESTION_MAX_LENGTH=2000
# How many sub-queries ST-22's rewrite-and-split may produce for one
# question. It is a COST ceiling, not a quality knob: every extra query is
# a real search and, on retry, more model calls.
MAX_SUB_QUERIES=5

# --- Chunking (architecture 7.5) ---
CHUNK_CHILD_SIZE_CHARS=500
CHUNK_CHILD_OVERLAP_CHARS=100
PARENT_MERGE_BELOW_CHARS=2000
PARENT_SPLIT_ABOVE_CHARS=4000
# What counts as a citable unit inside a section, for the F-03 label. A
# legal corpus numbers its articles, so a passage is cited as "Article 231"
# rather than by the heading it happens to sit under. A corpus with no
# numbered unit falls back to the enclosing heading automatically.
PARENT_CITATION_MARKER_PATTERN=Article\s+\d+

# --- Workspaces (F-01) ---
# Validation bounds on a workspace name and its folder path. Names are
# normalised before they are checked AND before they are stored -- ST-11
# shipped a bug where those two disagreed, validating a stripped name and
# persisting the raw one.
WORKSPACE_NAME_MIN_LENGTH=1
WORKSPACE_NAME_MAX_LENGTH=100
WORKSPACE_FOLDER_PATH_MIN_LENGTH=1

# --- Ingestion (F-02, architecture 5.1) ---
# The file types Sync processes in V1 (LD-03). Anything else is reported
# Skipped with a reason and never silently ignored. Change detection and
# the conversion ladder BOTH read this one list, so a file can never be
# scanned as one type and converted as another.
SUPPORTED_DOCUMENT_EXTENSIONS=["pdf","docx","txt","md"]
# Block size for the content hash, in bytes (1 MiB). Files are hashed
# incrementally so a large PDF never lands in memory whole.
HASH_READ_CHUNK_BYTES=1048576
# How long a SQLite connection waits for a lock before giving up. sqlite3's
# own default is 5 seconds, which is short for a sync writing a row per
# file; a test pins that this value is what actually gets passed.
SQLITE_BUSY_TIMEOUT_SECONDS=30.0

# --- Conversion ladder (ST-13, ADR-07) ---
# Minimum non-whitespace characters a converted file must yield before it
# counts as having a readable text layer. Below this it is Skipped, which is
# the binding V1 behaviour for a scanned PDF (PRD F-16).
CONVERSION_MIN_TEXT_CHARS=1
# Codec for the TXT / MD passthrough. utf-8-sig reads plain UTF-8 and also
# strips the byte-order mark Windows editors prepend. Decoding is strict:
# a file in another encoding is reported Failed, never silently mojibaked.
TEXT_FILE_ENCODING=utf-8-sig

# --- Store paths (data locality LD-06; all under data/, gitignored) ---
QDRANT_STORAGE_PATH=data/qdrant/
PARENT_STORE_PATH=data/parents/
SQLITE_DB_PATH=data/sanad.db
REPORTS_PATH=data/reports/

# --- Server (ADR-13; localhost only, LD-07) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
