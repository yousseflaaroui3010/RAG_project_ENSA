#!/usr/bin/env bash
# codebase-memory-mcp search augmenter (Claude Code PreToolUse).
# NOTE: the legacy filename is kept for zero-migration upgrades.
# Despite the name this NEVER blocks a tool call - it only adds
# graph context. Any failure is silent (exit 0, no output).
#
# The binary is resolved from PATH first, then from the default install
# location under the CURRENT user's home. The upstream package hardcodes
# one developer's absolute path, which disables this hook for everyone
# else on the team - and because every failure here is silent by design,
# nothing would ever report it. $HOME keeps it working per machine.
BIN="$(command -v codebase-memory-mcp 2>/dev/null)"
[ -n "$BIN" ] || BIN="$HOME/.local/bin/codebase-memory-mcp.exe"
[ -x "$BIN" ] || exit 0
"$BIN" hook-augment 2>/dev/null
exit 0
