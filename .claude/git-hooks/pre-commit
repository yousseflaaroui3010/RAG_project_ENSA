#!/usr/bin/env bash
# Belt-and-braces lock at the git level: blocks ANY direct commit on a
# protected branch (even from a human terminal), while letting merge
# commits through so the human's merges keep working.
# INSTALL (human only, per clone; agents are blocked from .git/hooks):
#   cp .claude/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
PROTECTED="main master production"
BR="$(git branch --show-current 2>/dev/null)"
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0   # merges pass
for P in $PROTECTED; do
  if [ "$BR" = "$P" ]; then
    echo "pre-commit: direct commits on '$P' are blocked. Use a task branch." >&2
    exit 1
  fi
done
exit 0
